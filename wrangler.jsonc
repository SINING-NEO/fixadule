{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fixadule",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fixadule",
      "database_id": "local-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
